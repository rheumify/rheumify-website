{
  "redirects": [
    {
      "source": "/scriptswap",
      "destination": "/tools/scriptswap",
      "permanent": true
    },
    {
      "source": "/patients/insurance",
      "destination": "/patients",
      "permanent": false
    },
    {
      "source": "/patients/insurance/:path*",
      "destination": "/patients",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
